{
  "name": "demo-reporting",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/demo-reporting/src",
  "tags": [
    "type:app",
    "scope:demo"
  ],
  "implicitDependencies": [
    "reporting-theme"
  ],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/demo-reporting",
        "index": "apps/demo-reporting/src/index.html",
        "browser": "apps/demo-reporting/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/demo-reporting/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/demo-reporting/public"
          }
        ],
        "styles": [
          "apps/demo-reporting/src/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "libs/reporting/theme/src"
          ]
        },
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "demo-reporting:build:production"
        },
        "development": {
          "buildTarget": "demo-reporting:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "demo-reporting:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "reportsDirectory": "../../coverage/apps/demo-reporting"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "demo-reporting:build",
        "staticFilePath": "dist/apps/demo-reporting/browser",
        "spa": true
      }
    }
  }
}