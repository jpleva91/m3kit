{
  "name": "reporting-shell",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/reporting/shell/src",
  "prefix": "rpt",
  "projectType": "library",
  "tags": ["type:lib", "scope:reporting-shell"],
  "targets": {
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../../coverage/libs/reporting/shell"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "component-test": {
      "executor": "@nx/cypress:cypress",
      "options": {
        "cypressConfig": "libs/reporting/shell/cypress.config.ts",
        "testingType": "component",
        "skipServe": true,
        "devServerTarget": "demo-reporting:build"
      }
    }
  }
}
