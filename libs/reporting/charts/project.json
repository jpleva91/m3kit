{
  "name": "reporting-charts",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/reporting/charts/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["type:lib", "scope:reporting-charts"],
  "targets": {
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../../coverage/libs/reporting/charts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "component-test": {
      "executor": "@nx/cypress:cypress",
      "options": {
        "cypressConfig": "libs/reporting/charts/cypress.config.ts",
        "testingType": "component",
        "skipServe": true,
        "devServerTarget": "demo-reporting:build"
      }
    }
  }
}
