{
  "name": "reporting-material",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/reporting/material/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [
    "type:lib",
    "scope:reporting-material"
  ],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/reporting/material/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "libs/reporting/material/.storybook",
        "browserTarget": "reporting-material:build-storybook",
        "compodoc": false,
        "styles": [
          "node_modules/@angular/material/prebuilt-themes/azure-blue.css",
          "apps/demo-reporting/src/styles.scss"
        ]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": [
        "{options.outputDir}"
      ],
      "options": {
        "outputDir": "dist/storybook/reporting-material",
        "configDir": "libs/reporting/material/.storybook",
        "browserTarget": "reporting-material:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c libs/reporting/material/.storybook --url=http://localhost:4400"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": [
        "build-storybook"
      ],
      "options": {
        "buildTarget": "reporting-material:build-storybook",
        "staticFilePath": "dist/storybook/reporting-material",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "reporting-material:build-storybook:ci"
        }
      }
    }
  }
}